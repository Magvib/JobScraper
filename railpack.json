{
  "$schema": "https://schema.railpack.com",
  "provider": "php",
  "buildAptPackages": [
    "curl",
    "ca-certificates",
    "gnupg"
  ],
  "steps": {
    "setup-node": {
      "commands": [
        "curl -fsSL https://nodesource.com | bash -",
        "apt-get install -y nodejs"
      ]
    }
  },
  "deploy": {
    "aptPackages": [
      "chromium",
      "libgbm1",
      "libnss3",
      "libatk-bridge2.0-0",
      "libasound2"
    ],
    "commands": [
      "curl -fsSL https://nodesource.com | bash -",
      "apt-get install -y nodejs"
    ]
  }
}